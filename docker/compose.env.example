# Sao chép thành .env ở thư mục gốc repo (cạnh docker-compose.yml) rồi điền giá trị. File .env KHÔNG được commit.

# --- Bắt buộc ---
POSTGRES_PASSWORD=doi-mat-khau-db
CHATBOT_RO_PASSWORD=doi-mat-khau-chatbot-ro
CHATBOT_RAG_PASSWORD=doi-mat-khau-chatbot-rag
# >= 32 ký tự ngẫu nhiên
JWT_SECRET=thay-bang-chuoi-ngau-nhien-it-nhat-32-ky-tu
# Khoá dùng chung backend <-> dịch vụ AI (chuỗi ngẫu nhiên)
AI_INTERNAL_KEY=thay-bang-chuoi-ngau-nhien

# --- Tuỳ chọn ---
# Email đã đăng ký sẽ được cấp ADMIN khi backend khởi động
ADMIN_EMAIL=

# Thư mục 2 repo còn lại (mặc định nằm cạnh repo này)
#FE_DIR=../fe-tripnova
#AI_DIR=../travel_chatbot_python/travel_chatbot
# .env của dịch vụ AI (khoá Gemini: LLM_BASE_URL, LLM_API_KEY, CHAT_MODEL, EMBEDDING_MODEL...)
#AI_ENV_FILE=../travel_chatbot_python/travel_chatbot/.env

# Cổng trên máy host
#DB_PORT=5433
#BACKEND_PORT=8080
#FRONTEND_PORT=3000
#MAILPIT_UI_PORT=8025
#MAILPIT_SMTP_PORT=1025
#OSRM_PORT=5000
# Địa chỉ trình duyệt dùng để gọi backend (FE build sẵn giá trị này) / mở FE (link trong email)
#BACKEND_PUBLIC_URL=http://localhost:8080
#FRONTEND_URL=http://localhost:3000

# Email: mặc định gửi vào Mailpit (http://localhost:8025). SMTP thật, VD Gmail (cần App Password):
#MAIL_HOST=smtp.gmail.com
#MAIL_PORT=587
#MAIL_USERNAME=ban@gmail.com
#MAIL_PASSWORD=app-password
#MAIL_SMTP_AUTH=true
#MAIL_STARTTLS=true
#MAIL_FROM=TripNova <ban@gmail.com>

# Đường đi: mặc định máy chủ demo OSRM công cộng (chỉ để thử). Tự host: docker compose --profile routing up -d
#ROUTING_BASE_URL=http://osrm:5000
#ROUTING_MAX_CONCURRENT=8
#OSRM_REGION=asia/vietnam

# Đăng nhập mạng xã hội (để trống = ẩn nút)
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
#FACEBOOK_CLIENT_ID=
#FACEBOOK_CLIENT_SECRET=
#GITHUB_CLIENT_ID=
#GITHUB_CLIENT_SECRET=
